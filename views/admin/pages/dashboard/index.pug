extends ../../layouts/default.pug 

block main 

    section#accountInfo
      h2 Trang quản trị 
      .row
        .col-md-6
          h4 Thông tin tài khoản 
          ul
            li
              strong H&#x1ECD; v&agrave; t&ecirc;n:
              |  #{user.fullName}
            li
              strong Email:
              |  #{user.email}
            li
              strong S&#x1ED1; &dstrok;i&#x1EC7;n tho&#x1EA1;i:
              |  #{user.phone}
            li
              strong Ph&acirc;n quy&#x1EC1;n:
              |  #{localRoles.title}
        
    hr
    section#productCategories
      .row
        .col-md-6
          h4 Danh mục sản phẩm 
          ul
            li 
              strong Số lượng 
              | #{statistis.productCategory.total}
            li 
              strong Hoạt động 
              | #{statistis.productCategory.active}
            li
              strong Dừng hoạt động 
              | #{statistis.productCategory.inactive}
        .col-md-6
          h4 Sản phẩm 
          ul
            li 
              strong Số lượng 
              | #{statistis.products.total}
            li 
              strong Hoạt động 
              | #{statistis.products.active}
            li
              strong Dừng hoạt động 
              | #{statistis.products.inactive}
    section#productCategories
      .row
        .col-md-6
          h4 Tài khoản Admin 
          ul
            li 
              strong Số lượng 
              | #{statistis.account.total}
            li 
              strong Hoạt động 
              | #{statistis.account.active}
            li
              strong Dừng hoạt động 
              | #{statistis.account.inactive}
        .col-md-6
          h4 Tài khoản khách hàng 
          ul
            li 
              strong Số lượng 
              | #{statistis.user.total}
            li 
              strong Hoạt động 
              | #{statistis.user.active}
            li
              strong Dừng hoạt động 
              | #{statistis.user.inactive}
    section#productCategories
      .row
        .col-md-6
          h4 Tin tức  
          ul
            li 
              strong Số lượng 
              | #{statistis.news.total}
            li 
              strong Hoạt động 
              | #{statistis.news.active}
            li
              strong Dừng hoạt động 
              | #{statistis.news.inactive} 
    .container.my-5
      .card(style='width: 1000px')
        .card-header.bg-primary.text-white
          h3 Th&#x1ED1;ng k&ecirc; v&agrave; B&aacute;o c&aacute;o
        .card-body
          .form-group
            label(for='period') Th&#x1ED1;ng k&ecirc; theo:
            select#period.form-control(select-date-statistics)
              option(value) Chọn 1 thời gian
              option(value='day' selected=(daySelected === 'day' ? true : false)) Ngày 
              option(value='week') Tuần 
              option(value='month') Tháng 
              option(value='year') Năm
          .statistics
            h4 Doanh Thu ngày hôm nay  
            p
              | S&#x1ED1; s&aacute;ch &dstrok;&atilde; b&aacute;n: 
              span#books-sold #{infoStatistisByDate.countOfBooks}
            p
              | T&#x1ED5;ng doanh thu: 
              span#total-revenue #{infoStatistisByDate.Revenue}
            p C&aacute;c thu&#x1ED9;c t&iacute;nh kh&aacute;c: 
            h3 Danh sách hóa đơn 
            ul.list-group 
              each item in infoStatistisByDate.orders
                li.list-group-item #{moment(item.createdAt).format('MMMM Do YYYY, h:mm:ss a')} - Số Lượng #{item.products.length}
        .card-footer.text-right
          button.btn.btn-success(btn-exportReport) Xu&#x1EA5;t b&aacute;o c&aacute;o ra Excel
          button.btn.btn-danger(onclick="exportReport('pdf')") Xu&#x1EA5;t b&aacute;o c&aacute;o ra PDF
          button.btn.btn-primary(onclick="exportReport('word')") Xu&#x1EA5;t b&aacute;o c&aacute;o ra Word 

    form(action="/admin/dashboard/export-report" method="POST" form-export-report).d-none
      input(type="text" name='orders' value=infoStatistisByDate)