header
      .top-banner
        img(src='images/logo.img', alt=' Logo')
        .promo-banner
          span.promo-text T&#x1AF;NG B&#x1EEA;NG H&Egrave; SANG R&#x1ED8;N R&Agrave;NG &#x1AF;U &Dstrok;&Atilde;I
          span.promo-discount -50%
          button.buy-now MUA NGAY
        form(action="/search").search-bar
          .search-icon
            img(src='images/Grid.png', alt='Grid Icon')
          input(type='text', placeholder='Sách giáo khoa 2024', name='keyword', value=keyword)
          button(type='submit')
            img(src='images/Search.png', alt='Search')
        .user-actions
          .icon-menu
            .icon-item
              img(src='images/bell.png', alt='Thông Báo')
              span Th&ocirc;ng B&aacute;o  
            a(href="/chats" style='text-decoration: none').icon-item
              img(src='images/message.png', alt='Giỏ Hàng')
              span.position-relative Nhắn tin
            a(href="/cart" style='text-decoration: none').icon-item 
              img(src='images/cart.png', alt='Giỏ Hàng')
              span.position-relative Giỏ hàng 
                span.position-absolute.top-0.start-100.translate-middle.badge.rounded-pill.bg-danger
                  | #{miniCart ? miniCart.products.length : ""}
            if user
              a(href="/user/profiles" style='text-decoration: none').icon-item
                img(src='images/user.png', alt='Tài khoản')
                span #{user.fullName}   
            else 
              a(href="/user/login" style='text-decoration: none').icon-item
                img(src='images/user.png', alt='Tài khoản')
                span Tài khoản 