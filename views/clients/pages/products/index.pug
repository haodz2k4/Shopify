extends ../../layouts/default.pug 

block main 
    .container.mt-5
      .row
        .col-md-3.filter-section
          h4.text-danger.font-weight-bold Lọc theo 
          .mb-4
            h5 DANH MỤC 
            each item in productCategory
              .form-check
                input#category1.form-check-input(type='checkbox' value=item.slug check-category)
                label.form-check-label(for='category1' ) #{item.title}
          .mb-4
            h5 GI&Aacute;
            .form-check
              input#price1.form-check-input(type='checkbox' value='0-150000' price-range)
              label.form-check-label(for='price1') 0&dstrok; - 150,000&dstrok; (3670)
            .form-check
              input#price2.form-check-input(type='checkbox' value='150000-300000' price-range)
              label.form-check-label(for='price2') 150,000&dstrok; - 300,000&dstrok; (785)
            .form-check
              input#price3.form-check-input(type='checkbox' value='300000-500000' price-range)
              label.form-check-label(for='price3') 300,000&dstrok; - 500,000&dstrok; (192)
            .form-check
              input#price4.form-check-input(type='checkbox' value='500000-700000' price-range)
              label.form-check-label(for='price4') 500,000&dstrok; - 700,000&dstrok; (39)
            .form-check
              input#price5.form-check-input(type='checkbox' price-range)
              label.form-check-label(for='price5') 700,000&dstrok; Tr&#x1EDF; L&ecirc;n (34)
           
          
        .col-md-9
          .d-flex.justify-content-between.align-items-center.mb-4
           
            .d-flex
              select.custom-select.mr-2(select-sorting)
                option(selected='' ) S&#x1EAF;p x&#x1EBF;p theo
                option(value='') &Dstrok;&#x1ED9; li&ecirc;n quan
                option(value='price-asc') Gi&aacute; Cao - Th&#x1EA5;p
                option(value='price-desc') Gi&aacute; Th&#x1EA5;p - Cao
              select.custom-select
                option(selected='') C&ograve;n h&agrave;ng
                option(value='1') C&ograve;n h&agrave;ng
                option(value='2') H&#x1EBF;t h&agrave;ng
          .row
           each item in product
            .col-md-3
              a(href="/products/detail/"+item.slug style='text-decoration: none').card.mb-4
                img.card-img-top(src=item.thumbnail, alt='Product 1')
                .card-body
                  h5.card-title #{item.title}
                  p.card-text
                    span.current-price.text-danger #{item.newPrice}
                    span.old-price.text-muted
                      span #{item.price} &dstrok;
                    span.badge.badge-danger 18%
            
        
    nav(aria-label='Page navigation example')
      ul.pagination.justify-content-center
        li.page-item(class=(objectPagination.currentPages === 1 ? "disabled": ""))
          a.page-link(href='#', tabindex='-1', aria-disabled='true',btn-pagination=objectPagination.currentPages - 1) Previous
        - for (let i = 1; i <= objectPagination.listPages; i++)
          li.page-item(class=(objectPagination.currentPages === i ? "active" : ""))
            a.page-link(href='#' btn-pagination=i) #{i}
        li.page-item(class=(objectPagination.currentPages === objectPagination.listPages ? "disabled": ""))
          a.page-link(href='#' btn-pagination=objectPagination.currentPages + 1) Next