extends ../../layouts/default.pug 

block main 
    .container.mt-5
      .row
        .col-md-3.filter-section
          h4.text-danger.font-weight-bold L&#x1ECC;C THEO
          .mb-4
            h5 DANH M&#x1EE4;C CH&Iacute;NH 
            each item in category
              .form-check
                input#category1.form-check-input(type='checkbox' value=item.slug checked=(checkCategory ? (item.id === checkCategory.id ? true : false) : false) check-category)
                label.form-check-label(for='category1' ) #{item.title}
            
          
            div
              label Ho&#x1EB7;c ch&#x1ECD;n m&#x1EE9;c gi&aacute; ph&ugrave; h&#x1EE3;p
              .d-flex
                input.form-control.mr-2(type='number', placeholder='0')
                input.form-control(type='number', placeholder='0')
          div
            h5 TH&#x1AF;&#x1A0;NG HI&#x1EC6;U
            .form-check
              input#brand1.form-check-input(type='checkbox')
              label.form-check-label(for='brand1') OEM (16)
            .form-check
              input#brand2.form-check-input(type='checkbox')
              label.form-check-label(for='brand2') Campus (7)
            .form-check
              input#brand3.form-check-input(type='checkbox')
              label.form-check-label(for='brand3') FAHASA (5)
        .col-md-9
          .d-flex.justify-content-between.align-items-center.mb-4
           
            .d-flex
              select.custom-select.mr-2(select-sorting)
                option(selected='' ) S&#x1EAF;p x&#x1EBF;p theo
                option(value='') &Dstrok;&#x1ED9; li&ecirc;n quan
                option(value='price-asc') Gi&aacute; Cao - Th&#x1EA5;p
                option(value='price-desc') Gi&aacute; Th&#x1EA5;p - Cao
              select.custom-select
                option(selected='') C&ograve;n h&agrave;ng
                option(value='1') C&ograve;n h&agrave;ng
                option(value='2') H&#x1EBF;t h&agrave;ng
          .row
           each item in products
            .col-md-3
              .card.mb-4
                img.card-img-top(src=item.thumbnail, alt='Product 1')
                .card-body
                  h5.card-title #{item.title}
                  p.card-text
                    span.current-price.text-danger #{item.newPrice}
                    span.old-price.text-muted
                      del #{item.price} &dstrok;
                    span.badge.badge-danger 18%
            