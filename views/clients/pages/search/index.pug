extends ../../layouts/default.pug 

block main 
    .highlighted-products
        h5.mb-5 
        .row
          each item in products
            form(action="/cart/add/"+item.id method="POST").col-md-3
              a(href="/products/detail/"+item.slug style='text-decoration: none').card.mb-4
                img.card-img-top(src=item.thumbnail, alt='Product 1')
                .card-body
                  h5.card-title #{item.title}
                  p.card-text.price
                    span.current-price #{item.priceNew} 
                    span.old-price #{item.price} &dstrok;
                  p.card-text.quantity S&#x1ED1; l&#x1B0;&#x1EE3;ng: 10  
                  button.btn.btn-primary(btn-add-cart=item.id type='submit') Thêm vào giỏ hàng    
                    i.fa-solid.fa-cart-shopping     